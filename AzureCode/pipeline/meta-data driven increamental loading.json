{
	"name": "meta-data driven increamental loading",
	"properties": {
		"activities": [
			{
				"name": "tablesMetadata",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_JsonData",
						"type": "DatasetReference",
						"parameters": {
							"container": "bronze",
							"folder": "lastload",
							"file": "tablesdata.json"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "tablesMetadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('tablesMetadata').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "lastload",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "JsonSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "JsonReadSettings"
									}
								},
								"dataset": {
									"referenceName": "DS_JsonData",
									"type": "DatasetReference",
									"parameters": {
										"container": "bronze/lastload",
										"folder": {
											"value": "@item().table",
											"type": "Expression"
										},
										"file": "lastload.json"
									}
								}
							}
						},
						{
							"name": "latestload",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select max(@{item().column}) as latestload from @{item().schema}.@{item().table}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_AzureSqlTable",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "currentdate",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentdate",
								"value": {
									"value": "@utcNow()",
									"type": "Expression"
								}
							}
						},
						{
							"name": "increamentaldataloading",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "lastload",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "latestload",
									"dependencyConditions": [
										"Succeeded"
									]
								},
								{
									"activity": "currentdate",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "SELECT *\r\nFROM @{item().schema}.@{item().table}\r\nWHERE @{item().column} > '@{if(empty(coalesce(item().backdate, '')), activity('lastload').output.firstRow.lastload, item().backdate)}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_AzureSqlTable",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_ParquetData",
									"type": "DatasetReference",
									"parameters": {
										"container": "bronze/rawdata",
										"folder": {
											"value": "@item().table",
											"type": "Expression"
										},
										"file": {
											"value": "@concat(item().table,'_',variables('currentdate'))",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "If Condition",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "increamentaldataloading",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('increamentaldataloading').output.rowsRead, 0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Deletefile",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_ParquetData",
												"type": "DatasetReference",
												"parameters": {
													"container": "bronze/rawdata",
													"folder": {
														"value": "@item().table",
														"type": "Expression"
													},
													"file": "@concat(item().table,'_',variables('currentdate'))"
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "updatelastloadvalue",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "JsonSource",
												"additionalColumns": [
													{
														"name": "lastload",
														"value": {
															"value": "@activity('latestload').output.firstRow.latestload",
															"type": "Expression"
														}
													}
												],
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "JsonReadSettings"
												}
											},
											"sink": {
												"type": "JsonSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "JsonWriteSettings"
												}
											},
											"enableStaging": false
										},
										"inputs": [
											{
												"referenceName": "DS_JsonData",
												"type": "DatasetReference",
												"parameters": {
													"container": "bronze",
													"folder": "lastload",
													"file": "empty.json"
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_JsonData",
												"type": "DatasetReference",
												"parameters": {
													"container": "bronze/lastload",
													"folder": {
														"value": "@item().table",
														"type": "Expression"
													},
													"file": "lastload.json"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "logicappurl",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "ForEach",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://spotifyprojectkeyvault.vault.azure.net/secrets/logicappurl?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "updateofpipeline",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logicappurl",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@activity('logicappurl').output.value",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    'pipeline_name' : '@{pipeline().Pipeline}',\n    'pipeline_runID' : '@{pipeline().RunId}'\n}",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"currentdate": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-11T12:39:50Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}